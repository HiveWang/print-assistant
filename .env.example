# 网页入口端口
PRINT_ASSISTANT_PORT=8080

# 如果部署机使用本机 CUPS，无需填写；deploy.sh 会自动挂载 Socket。
# 如果使用独立 CUPS 打印服务器，填写“IP:端口”。
# CUPS_SERVER=10.10.10.20:631

# 可选：指定首次打开时选中的打印队列名
# DEFAULT_PRINTER=Office_Color

# 可选：为 CUPS 队列补充办公区位置（必须是单行合法 JSON）
PRINTER_LOCATIONS_JSON={"Office_Color":"5F 东侧","Office_BW":"3F 文印区"}

# 会话与任务限制
SESSION_TTL_HOURS=8
MAX_FILE_SIZE_MB=100
MAX_FILES=50
PRINT_WORKERS=2
HISTORY_LIMIT=100
